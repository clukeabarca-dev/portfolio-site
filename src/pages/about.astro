---
import BaseLayout from "../layouts/BaseLayout.astro";

const capabilities = [
  "Creative direction",
  "Art direction",
  "Identity systems",
  "Brand development",
  "Marketing campaigns",
  "Packaging and print",
  "Posters and campaign graphics",
  "Commercial signage",
  "Websites and applications",
];

const clients = [
  "CVS",
  "Longs Drugs",
  "University of Hawaii",
  "Manoa Now",
  "KTM Enjoy Snacks",
  "Aloha Gourmet",
  "Island Living",
  "Mondelez",
  "Rotary Hawaii",
  "United States Navy",
  "Kelly Lui",
];

const aboutImages = [
  {
    src: "/images/about/optimized/street-signage.jpg",
    alt: "A busy Japan street filled with layered storefront signs and overhead wires.",
    caption: "Signage",
  },
  {
    src: "/images/about/optimized/portrait-blue-installation.jpg",
    alt: "Christopher Abarca standing in a blue-lit installation space.",
    caption: "Atmosphere",
  },
  {
    src: "/images/about/optimized/vending-machines.jpg",
    alt: "A row of illustrated vending machines and drink displays in Japan.",
    caption: "Observation",
  },
];

const everydayImages = [
  {
    src: "/images/about/optimized/street-signage.jpg",
    alt: "A busy Japan street filled with layered storefront signs and overhead wires.",
    caption: "Signage",
  },
  {
    src: "/images/about/optimized/night-tunnel.jpg",
    alt: "A lit tunnel entrance and surrounding city signs at night.",
    caption: "Light",
  },
  {
    src: "/images/about/optimized/train-platform.jpg",
    alt: "Train platforms, rails, signs, and city buildings under warm daylight.",
    caption: "Movement",
  },
  {
    src: "/images/about/optimized/pink-installation-portrait.jpg",
    alt: "A portrait inside a vivid pink floral light installation.",
    caption: "Color",
  },
  {
    src: "/images/about/optimized/cat-detail.jpg",
    alt: "A cat resting in a patterned hammock under a wooden shelf.",
    caption: "Detail",
  },
  {
    src: "/images/about/optimized/installation-texture.jpg",
    alt: "Christopher Abarca seated in an immersive installation with pink and blue light.",
    caption: "Texture",
  },
];

const principles = [
  {
    title: "Collaborative range",
    text: "I like working across fields, especially when a brand has to connect a product, campaign, screen, printed piece, and physical space at the same time.",
  },
  {
    title: "Balance and story",
    text: "The structure makes the work useful. The storytelling gives it a reason to last and helps each touchpoint feel part of the same recognizable message.",
  },
  {
    title: "Place with restraint",
    text: "Living around the globe has given my work a sense of transition, boldness, texture, and atmosphere without leaning on obvious visual cliches.",
  },
];

const process = ["Listen", "Structure", "Build", "Extend"];
---

<BaseLayout
  title="About"
  description="About Christopher Abarca, a graphic designer with over a decade of experience in creative direction, art direction, marketing, brand identity, and digital development."
>
  <section class="about-hero">
    <div class="about-hero__copy" data-reveal>
      <p class="eyebrow">About</p>
      <h1>Graphic designer building brands, identities, and digital work through collaboration and story.</h1>
      <p>
        My name is Christopher Abarca. I am a graphic designer with experience in creative direction,
        art direction, marketing, and digital development. I have over a decade of experience in the field,
        and I love building brands and identities that can live across many touchpoints.
      </p>
    </div>
    <figure class="about-hero__portrait" data-reveal>
      <img
        src="/images/about/optimized/portrait-blue-installation.jpg"
        alt="Christopher Abarca standing inside a blue-lit installation space."
      />
      <figcaption>
        <span>Portrait</span>
        Christopher Abarca
      </figcaption>
    </figure>
  </section>

  <section class="about-image-strip" aria-label="About page visual references">
    {
      aboutImages.map((image, index) => (
        <figure class:list={["about-image-strip__item", index === 1 && "about-image-strip__item--tall"]} data-reveal>
          <img src={image.src} alt={image.alt} loading="lazy" />
          <figcaption>
            <span>{String(index + 1).padStart(2, "0")}</span>
            {image.caption}
          </figcaption>
        </figure>
      ))
    }
  </section>

  <section class="about-grid about-grid--statement">
    <div class="about-grid__intro" data-reveal>
      <p class="eyebrow">Practice</p>
      <p>
        I work best in collaborative efforts across fields. When a brand or company needs to show up
        in more than one place, I get excited about solving how the same recognizable message can fit
        onto a screen, in a newspaper, in a store, or across a campaign.
      </p>
      <p>
        I care about balance and storytelling. That balance makes the work useful, recognizable, and lasting.
      </p>
    </div>
    <div class="about-grid__notes" data-reveal>
      <h2>Capabilities</h2>
      <ul>
        {capabilities.map((capability) => <li>{capability}</li>)}
      </ul>
    </div>
  </section>

  <section class="about-clients" aria-label="Selected clients and collaborators">
    <div data-reveal>
      <p class="eyebrow">Selected clients and collaborators</p>
      <h2>Experience across retail, education, food, media, civic, military, healthcare, and local business.</h2>
    </div>
    <ul data-reveal>
      {clients.map((client) => <li>{client}</li>)}
    </ul>
  </section>

  <section class="about-principles" aria-label="Design principles">
    {
      principles.map((principle, index) => (
        <article data-reveal>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <h2>{principle.title}</h2>
          <p>{principle.text}</p>
        </article>
      ))
    }
  </section>

  <section class="about-process">
    <div data-reveal>
      <p class="eyebrow">How I work</p>
      <h2>A simple process for turning the story into a flexible working system.</h2>
    </div>
    <ol data-reveal>
      {
        process.map((step) => (
          <li>
            <span>{step}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="about-personal" data-reveal>
    <p class="eyebrow">Point of view</p>
    <p>
      Outside of project work, I pay attention to everyday design: storefront signs, transit systems,
      menus, packaging, lighting, and the small details that make a place feel recognizable.
    </p>
  </section>

  <section class="about-everyday" aria-label="Everyday design references">
    {
      everydayImages.map((image) => (
        <figure data-reveal>
          <img src={image.src} alt={image.alt} loading="lazy" />
          <figcaption>{image.caption}</figcaption>
        </figure>
      ))
    }
  </section>

  <section class="index-band index-band--light" data-reveal>
    <div>
      <p class="eyebrow">Availability</p>
      <h2>Open to freelance, full-time, and contract opportunities in Seattle, Hawaii, and remote teams.</h2>
    </div>
    <a class="button" href="mailto:clukeabarca@icloud.com">Start a conversation</a>
  </section>
</BaseLayout>
