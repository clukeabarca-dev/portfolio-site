---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { isPublishedProject, sortProjectsByOrder } from "../lib/projects";

const projects = (await getCollection("projects")).filter(isPublishedProject).sort(sortProjectsByOrder);
const featuredProjectIds = [
  "longs-drugs-brand-revival",
  "island-living-eco-goods",
  "hana-paw-pet-goods",
  "hoku-lei-jewelry",
  "manoa-now-identity",
  "akira-toriyama-early-works",
];
const projectById = new Map(projects.map((project) => [project.id, project]));
const featuredProjects = featuredProjectIds
  .map((id) => projectById.get(id))
  .filter((project) => project !== undefined);
const heroVisuals = [
  {
    src: "/images/projects/longs-drugs-brand-revival/cover.webp",
    alt: featuredProjects[0]?.data.coverAlt ?? projects[0]?.data.coverAlt,
    label: "Identity",
  },
  {
    src: "/images/projects/hana-paw-pet-goods/cover.webp",
    alt: "Dog resting in soft natural light.",
    label: "Campaign",
  },
  {
    src: projects[2]?.data.gallery?.[1]?.src ?? projects[2]?.data.cover,
    alt: projects[2]?.data.gallery?.[1]?.alt ?? projects[2]?.data.coverAlt,
    label: "Archive",
  },
].filter((image) => image.src && image.alt);
const visualReelSelections = [
  { id: "longs-drugs-brand-revival", galleryIndex: null },
  { id: "longs-sans", galleryIndex: 0 },
  { id: "island-living-eco-goods", galleryIndex: 1 },
  { id: "hana-paw-pet-goods", galleryIndex: 2 },
  { id: "manoa-now-identity", galleryIndex: 1 },
  { id: "identity-studies", galleryIndex: null },
  { id: "akira-toriyama-early-works", galleryIndex: 9 },
];
const visualReel = visualReelSelections
  .map(({ id, galleryIndex }) => {
    const project = projectById.get(id);
    if (!project) return null;

    const galleryImage = galleryIndex === null ? undefined : project.data.gallery?.[galleryIndex];
    if (!galleryImage) {
      return {
        id: project.id,
        src: project.data.cover,
        alt: project.data.coverAlt,
        title: project.data.title,
        caption: project.data.disciplines[0],
      };
    }

    return {
      id: project.id,
      src: galleryImage.src,
      alt: galleryImage.alt,
      title: project.data.title,
      caption: galleryImage.caption,
    };
  })
  .filter((image) => image !== null);
---

<BaseLayout>
  <section class="hero">
    <div class="hero__inner">
      <p class="eyebrow" data-reveal>Graphic design / creative direction / digital development</p>
      <h1 data-reveal>
        Brands, identities, and visual systems built to hold together in the real world.
      </h1>
      <div class="hero__summary" data-reveal>
        <p>
          My name is Christopher Abarca. I am a graphic designer with experience in creative
          direction, art direction, marketing, and digital development. I have over a decade of
          experience, and I love building brands and identities.
        </p>
        <div class="hero__actions" aria-label="Primary actions">
          <a class="button" href="/work/">View work</a>
          <a class="button button--quiet" href="/about/">About me</a>
        </div>
      </div>
    </div>
    <div class="hero__visual" data-reveal>
      {
        heroVisuals.map((image, index) => (
          <figure class={`hero__image hero__image--${index + 1}`} data-parallax>
            <img src={image.src} alt={image.alt} loading={index === 0 ? "eager" : "lazy"} />
            <figcaption>
              <span>{String(index + 1).padStart(2, "0")}</span>
              {image.label}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <section class="section section--split">
    <div data-reveal>
      <p class="eyebrow">Practice</p>
      <h2>Collaborative brand systems for every place a message has to show up.</h2>
    </div>
    <p data-reveal>
      I work best in collaborative efforts across fields. When a brand or company needs to show up
      in more than one place, I get excited by the problem of making a campaign or product fit on a
      screen, in print, and in a store while still carrying the same recognizable message.
    </p>
  </section>

  <section class="visual-reel" aria-label="Visual project preview">
    <div class="visual-reel__intro" data-reveal>
      <p class="eyebrow">Approach</p>
      <div>
        <h2>Balance, storytelling, restraint, texture, and atmosphere.</h2>
        <p>
          I care about balance and storytelling because it makes the work useful and lasting. Living
          around the globe has given my work a sense of transition, boldness, texture, and
          atmosphere without leaning on obvious visual cliches.
        </p>
      </div>
    </div>
    <div class="visual-reel__track">
      {
        visualReel.map((image, index) => (
          <figure class:list={["visual-reel__item", `visual-reel__item--${image.id}`, index % 3 === 1 && "visual-reel__item--tall"]} data-reveal>
            <img src={image.src} alt={image.alt} loading="lazy" />
            <figcaption>
              <span>{image.title}</span>
              {image.caption}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="section__heading" data-reveal>
      <p class="eyebrow">Featured work</p>
      <h2>Selected work across identity, campaigns, packaging, type, environments, and digital products.</h2>
    </div>
    <div class="featured-grid">
      {featuredProjects.map((project) => <ProjectCard project={project} featured />)}
    </div>
  </section>

  <section class="index-band" data-reveal>
    <div>
      <p class="eyebrow">Work archive</p>
      <h2>Browse the larger archive of brand systems, printed pieces, product lines, and digital experiences.</h2>
    </div>
    <a class="button button--dark" href="/work/">View all work</a>
  </section>
</BaseLayout>
