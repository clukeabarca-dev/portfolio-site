---
const navItems = [
  { href: "/", label: "Index" },
  { href: "/work/", label: "Work" },
  { href: "/about/", label: "About" },
  { href: "/christopher-abarca-lead-brand-art-director-resume.pdf", label: "Resume" },
  { href: "https://www.linkedin.com/in/clukeabarca/", label: "LinkedIn", external: true },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header" data-reveal>
  <div class="site-header__inner">
    <a class="site-header__brand" href="/" aria-label="Christopher Abarca home">
      Christopher Abarca
    </a>
    <nav class="site-header__nav" aria-label="Primary navigation">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={currentPath === item.href ? "page" : undefined}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noopener" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
